# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# LTI Configuration
LTI_KEY=your-random-secret-key-here
LTI_URL=http://localhost:3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/moodle-tutorbot

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Moodle Platform Configuration (Optional - can be registered via API)
MOODLE_URL=https://your-moodle-instance.com
MOODLE_NAME=My Moodle Instance
MOODLE_CLIENT_ID=your-client-id-from-moodle
