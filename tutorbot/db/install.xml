<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/tutorbot/db" VERSION="2024102200" COMMENT="AI Tutorbot database schema">
    <TABLES>
        <TABLE NAME="local_tutorbot_memories" COMMENT="Stores user learning memories for personalization">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to user table" />
                <FIELD NAME="memories" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="User's learning memories and notes" />
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" />
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" />
            </KEYS>
            <INDEXES>
                <INDEX NAME="userid_index" UNIQUE="true" FIELDS="userid" />
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_tutorbot_chat" COMMENT="Stores chat history between users and AI tutor">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to user table" />
                <FIELD NAME="message_author" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Message author: user or model" />
                <FIELD NAME="message_text" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="The message content" />
                <FIELD NAME="timestamp" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp of message" />
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" />
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>